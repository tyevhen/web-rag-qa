# Local generator for the app. Build: ollama create web-rag-llm -f llm/Modelfile
FROM qwen2.5:7b-instruct-q4_K_M
# Ollama's default context is small and silently truncates the reasoner's 6-chunk prompt
PARAMETER num_ctx 16384
PARAMETER temperature 0
# Hard ceiling for calls without a cap (the policy check, the ingest summary): a runaway once generated for 3 h
PARAMETER num_predict 2048
