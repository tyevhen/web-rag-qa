# prod: append ?sslmode=require for Neon/Supabase
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/web_rag
# The app LLM: by default a local Ollama service (see README "Local LLM" and llm/Modelfile)
LLM_MODEL=web-rag-llm
SYSTEM_PROMPT=You are an emergency preparedness assistant based in Estonia but fully aware of global emergency preparedness practices. Answer questions based solely on the provided documents. If a question falls outside the scope of emergency preparedness or civil defense, politely let the user know it is beyond your knowledge.
INGEST_API_KEY=your_ingest_api_key_here
REDIS_URL=redis://localhost:6379
# Comma-separated list of allowed origins, or * for local dev
ALLOWED_ORIGINS=*
# Next.js UI (ui/.env.local)
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# LangSmith tracing (optional — remove or keep commented to disable)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=lsv2_pt_...
# LANGCHAIN_PROJECT=web-rag-qa
# Any other OpenAI-compatible endpoint (optional; default http://localhost:11434/v1, no key)
# LLM_BASE_URL=https://router.huggingface.co/v1
# LLM_API_KEY=...
# Seconds per LLM attempt (default 180) and per whole /ask run (default 600); lower them for a fast hosted model
# LLM_TIMEOUT=180
# REQUEST_TIMEOUT=600
# Where the dashboard Chat page reaches the API
# API_URL=http://localhost:8000
# Encoders (README "Switching encoders"): search uses EMBEDDER; ingestion also writes SHADOW_EMBEDDERS
# EMBEDDER=BAAI/bge-small-en-v1.5
# SHADOW_EMBEDDERS='["intfloat/multilingual-e5-small"]'
# Evaluation judge: any OpenAI-compatible endpoint (needed only for judged eval runs, nightly scoring, Score button)
# Must differ from LLM_MODEL (self-preference bias). gpt-oss-20b fits free-tier token limits.
# EVAL_JUDGE_BASE_URL=https://api.groq.com/openai/v1
# EVAL_JUDGE_API_KEY=...
EVAL_JUDGE_MODEL=openai/gpt-oss-20b
# EVAL_SAMPLE_SIZE=20                 # production answers scored by the nightly worker cron
