GROQ_API_KEY=your_groq_api_key_here
# prod: append ?sslmode=require for Neon/Supabase
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/web_rag
GROQ_MODEL=openai/gpt-oss-120b
SYSTEM_PROMPT=You are an emergency preparedness assistant based in Estonia but fully aware of global emergency preparedness practices. Answer questions based solely on the provided documents. If a question falls outside the scope of emergency preparedness or civil defense, politely let the user know it is beyond your knowledge.
INGEST_API_KEY=your_ingest_api_key_here
REDIS_URL=redis://localhost:6379
# Comma-separated list of allowed origins, or * for local dev
ALLOWED_ORIGINS=*
# Next.js UI (ui/.env.local)
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# LangSmith tracing (optional — remove or keep commented to disable)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=lsv2_pt_...
# LANGCHAIN_PROJECT=web-rag-qa
# LLM endpoint (optional). Switch the app to Hugging Face Inference Providers when Groq is down:
# LLM_BASE_URL=https://router.huggingface.co/v1
# GROQ_MODEL=meta-llama/Llama-3.3-70B-Instruct
# HF_TOKEN=hf_...
# Evaluation judge (optional). A stronger judge is better, but 20b fits the Groq free-tier token limits
# EVAL_JUDGE_PROVIDER=groq            # groq | hf (hf requires HF_TOKEN)
# Must differ from GROQ_MODEL (self-preference bias); e.g. Qwen/Qwen2.5-72B-Instruct for hf
EVAL_JUDGE_MODEL=openai/gpt-oss-20b
# EVAL_SAMPLE_SIZE=20                 # production answers scored by the nightly worker cron
