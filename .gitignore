# Allowlist: ignore everything at the root, then re-include what the project needs.
/*

# Project config
!/.gitignore
!/.dockerignore
!/.env.example
!/.python-version
!/pyproject.toml
!/uv.lock
!/Dockerfile
!/docker-compose.yml
!/render.yaml
!/settings.py
!/README.md

# Source
!/agent/
!/api/
!/dashboard/
!/db/
!/evaluation/
!/ingestion/
!/llm/
!/migrations/
!/services/
!/worker/
!/tests/
!/sources/

# Docs: only README.md at the root is tracked
*.md
!/README.md
!/sources/**/*.md

# Downloaded originals of the sources (third-party works)
/sources/**/*.pdf
/sources/**/*.txt
/sources/**/*.png

# Not applied by the migration runner (reads /migrations only)
/db/migrations/

# Python artifacts
__pycache__/
*.py[cod]

# Eval output
/tests/eval/results.json
/tests/eval/results/

# OS
.DS_Store
.scratch/
